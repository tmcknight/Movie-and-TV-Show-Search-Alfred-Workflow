{
  "bundleid": "com.mcknight.movies.details",
  "variablesconfig": {
    "item": {
      "src": "args[0]",
      "scriptenv": true
    },
    "omdb_api_key": {
      "src": "variable",
      "scriptenv": true
    },
    "locale": {
      "src": "variable",
      "scriptenv": true
    },
    "search_language": {
      "src": "variable",
      "scriptenv": true
    },
    "include_letterboxd": {
      "src": "variable",
      "scriptenv": true
    },
    "include_simkl": {
      "src": "variable",
      "scriptenv": true
    },
    "include_moviechat": {
      "src": "variable",
      "scriptenv": true
    },
    "include_justwatch": {
      "src": "variable",
      "scriptenv": true
    },
    "trailers_in_alfred": {
      "src": "variable",
      "scriptenv": true
    }
  },
  "window": {
    "title": "Movie and TV Show Details",
    "padding": 0,
    "root": {
      "type": "view",
      "id": "root",
      "layout": "stack",
      "cliptobounds": true,
      "appearance": "dark",
      "events": [
        {
          "triggers": "preload",
          "action": {
            "type": "script",
            "src": "./scripts/load.py",
            "args": [
              "{var:item}",
              "--route"
            ]
          }
        },
        {
          "triggers": "launched",
          "action": {
            "type": "script",
            "src": "./scripts/load.py",
            "args": [
              "{var:item}"
            ],
            "async": true
          }
        }
      ],
      "components": [
        {
          "type": "imageview",
          "id": "backdrop",
          "resize": "fit",
          "image": null,
          "constraints": {
            "insets": {
              "left": 200
            }
          }
        },
        {
          "type": "view",
          "id": "scrim",
          "layout": "stack",
          "background": "#00000099",
          "components": [
            {
              "type": "label",
              "text": " "
            }
          ]
        },
        {
          "type": "view",
          "id": "content",
          "layout": "border",
          "spacing": 20,
          "components": [
            {
              "type": "imageview",
              "id": "poster",
              "resize": "fit",
              "cornerradius": 8,
              "image": {
                "type": "symbol",
                "src": "film"
              },
              "constraints": {
                "region": "left",
                "position": "top",
                "size": {
                  "width": 180,
                  "height": 270
                }
              }
            },
            {
              "type": "view",
              "id": "info",
              "layout": "inline",
              "spacing": 12,
              "constraints": {
                "region": "centre",
                "position": "top"
              },
              "components": [
                {
                  "type": "view",
                  "layout": "inline",
                  "direction": "vertical",
                  "spacing": 4,
                  "components": [
                    {
                      "type": "label",
                      "id": "title",
                      "text": "Loading…",
                      "linebreak": "truncatetail",
                      "selectable": true,
                      "font": {
                        "size": "large",
                        "weight": "bold"
                      }
                    },
                    {
                      "type": "label",
                      "id": "subtitle",
                      "text": " ",
                      "linebreak": "truncatetail",
                      "colour": "secondaryLabelColor"
                    }
                  ]
                },
                {
                  "type": "label",
                  "id": "overview",
                  "text": "",
                  "linebreak": "wordwrap",
                  "selectable": true,
                  "constraints": {
                    "size": {
                      "width": 460
                    }
                  }
                },
                {
                  "type": "view",
                  "layout": "inline",
                  "direction": "vertical",
                  "spacing": 14,
                  "components": [
                    {
                      "type": "view",
                      "id": "credits",
                      "layout": "inline",
                      "components": [
                        {
                          "type": "label",
                          "text": " "
                        }
                      ],
                      "direction": "vertical",
                      "spacing": 4
                    },
                    {
                      "type": "view",
                      "id": "links",
                      "layout": "inline",
                      "components": [
                        {
                          "type": "label",
                          "text": " "
                        }
                      ],
                      "direction": "vertical",
                      "spacing": 2
                    }
                  ],
                  "constraints": {
                    "insets": {
                      "top": 6
                    }
                  }
                }
              ],
              "direction": "vertical"
            }
          ],
          "constraints": {
            "insets": {
              "top": 20,
              "right": 20,
              "bottom": 20,
              "left": 20
            }
          }
        }
      ]
    },
    "size": {
      "height": 400
    }
  }
}
